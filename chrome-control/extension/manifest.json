{
  "manifest_version": 3,
  "minimum_chrome_version": "109",
  "name": "Chrome 网页控制",
  "version": "1.4.0",
  "description": "让本地 Agent 在你允许的网页上读取正文、点击和填写。",
  "icons": {
    "16": "icons/tab-pointer-16.png",
    "32": "icons/tab-pointer-32.png",
    "48": "icons/tab-pointer-48.png",
    "128": "icons/tab-pointer-128.png"
  },
  "key": "",
  "permissions": ["activeTab", "nativeMessaging", "scripting", "storage", "tabs"],
  "host_permissions": ["https://*/*", "http://*/*", "file:///*"],
  "incognito": "not_allowed",
  "action": {
    "default_icon": {
      "16": "icons/tab-pointer-16.png",
      "20": "icons/tab-pointer-20.png",
      "24": "icons/tab-pointer-24.png",
      "32": "icons/tab-pointer-32.png",
      "48": "icons/tab-pointer-48.png"
    },
    "default_popup": "popup.html",
    "default_title": "Chrome 网页控制"
  },
  "background": { "service_worker": "worker.mjs", "type": "module" }
}
